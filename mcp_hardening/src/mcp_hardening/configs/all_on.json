{
  "version": 1,
  "request_auth": {
    "enabled": true
  },
  "response_auth": {
    "enabled": true
  },
  "replay_protection": {
    "enabled": true,
    "nonce_ttl_s": 300.0,
    "max_nonces": 100000
  },
  "freshness_check": {
    "enabled": true,
    "window_s": 120.0
  },
  "telemetry": {
    "enabled": true,
    "capture_content": true,
    "flush_rows": 500,
    "dir": "telemetry"
  }
}
