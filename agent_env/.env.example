# Copy to .env (gitignored) and fill in
OPENAI_API_KEY=
OPENAI_BASE_URL=https://tritonai-api.ucsd.edu/v1
OPENAI_MODEL=api-muse-glimmer-30b
# MCP hardening key (only needed when a --hardening-config enables security; generate with `mcp-hardening keygen`)
MCP_HARDENING_MASTER_KEY=
MCP_HARDENING_API_KEY_ENC=
# Optional default hardening config (file path or preset name: default, all_on, all_off, request_only, response_only)
# MCP_HARDENING_CONFIG=
